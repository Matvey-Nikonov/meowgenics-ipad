+#!/usr/bin/env python3
+"""Run production log pause/resume code against real host files and dispatch.
+
+Only C log callbacks/config and the Documents destination are replaced.
+Tests run with Swift optimization enabled; no device is launched.
+"""
+from pathlib import Path
+import os
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[2]
+app = root / "app/Madeira"
+store = (app / "LogStore.swift").read_text()
+documents = 'FileManager.default.urls(for: .documentDirectory, in: .userDomainMask).first!'
+assert store.count(documents) == 1
+store = store.replace(documents, 'URL(fileURLWithPath: CommandLine.arguments[1])')
+stubs = r'''
+import Foundation
+import SwiftUI
+var wineCallback: ((UnsafePointer<CChar>?) -> Void)?
+var jitCallback: ((UnsafePointer<CChar>?) -> Void)?
+func wine_set_ui_log_callback(_ callback: @escaping (UnsafePointer<CChar>?) -> Void) { wineCallback = callback }
+func jit_set_log_callback(_ callback: @escaping (UnsafePointer<CChar>?) -> Void) { jitCallback = callback }
+enum MadeiraConfig {
+    static var idleEnabled = true
+    static func flag(_ name: String) -> Bool {
+        if name == "MADEIRA_UI_LOG_IDLE" { return idleEnabled }
+        return false // Keep actual appendToFile, rather than redirecting host stderr.
+    }
+}
+'''
+tests = r'''
+extension LogTail {
+    func settleForTest() { queue.sync {} }
+}
+extension LogStore {
+    func settleTailForTest() { tail?.settleForTest() }
+    var hasFlushTimerForTest: Bool { flushTimer != nil }
+    var pendingForTest: Int {
+        stateLock.lock(); defer { stateLock.unlock() }
+        return pendingNew.count + pendingUpdates.count
+    }
+}
+func pump(_ seconds: Double = 0.1) { RunLoop.main.run(until: Date().addingTimeInterval(seconds)) }
+func append(_ text: String, to url: URL) throws {
+    let handle = try FileHandle(forWritingTo: url)
+    try handle.seekToEnd()
+    try handle.write(contentsOf: Data(text.utf8))
+    try handle.close()
+}
+final class Lines: @unchecked Sendable {
+    private let lock = NSLock()
+    private var value: [String] = []
+    func append(_ line: String) { lock.lock(); value.append(line); lock.unlock() }
+    var snapshot: [String] { lock.lock(); defer { lock.unlock() }; return value }
+}
+@main struct Checks {
+    static func main() throws {
+        let directory = URL(fileURLWithPath: CommandLine.arguments[1])
+        let store = LogStore.shared
+        store.settleTailForTest(); pump()
+        precondition(store.hasFlushTimerForTest)
+        store.log("queued_before_pause")
+        precondition(store.pendingForTest > 0)
+        store.setDisplayActive(false)
+        store.settleTailForTest(); pump()
+        precondition(!store.hasFlushTimerForTest && store.pendingForTest == 0)
+        let originalRows = store.entries.count
+        store.log("swift_hidden_marker")
+        "jit_hidden_marker".withCString { jitCallback?($0) }
+        "wine_hidden_marker".withCString { wineCallback?($0) }
+        try append("native_hidden_marker\n", to: directory.appendingPathComponent("madeira-log.txt"))
+        // uiPaused must not accidentally resurrect the suspended flush timer.
+        store.uiPaused = true
+        pump(0.4)
+        precondition(!store.hasFlushTimerForTest && store.pendingForTest == 0)
+        precondition(store.entries.count == originalRows)
+        let file = try String(contentsOf: directory.appendingPathComponent("madeira-log.txt"))
+        for marker in ["swift_hidden_marker", "jit_hidden_marker", "native_hidden_marker"] {
+            precondition(file.contains(marker), "lost persisted diagnostic: \(marker)")
+        }
+        store.uiPaused = false
+        store.setDisplayActive(true)
+        store.settleTailForTest(); pump()
+        store.log("visible_after_resume")
+        pump(0.4)
+        precondition(store.hasFlushTimerForTest)
+        precondition(store.entries.contains { $0.lastRaw.contains("visible_after_resume") })
+        precondition(!store.entries.contains { $0.lastRaw.contains("hidden_marker") })
+
+        // Exercise pause racing real background callback producers.
+        let producers = DispatchGroup()
+        for _ in 0..<4 {
+            DispatchQueue.global().async(group: producers) {
+                for _ in 0..<200 { "racing_callback".withCString { wineCallback?($0) } }
+            }
+        }
+        store.setDisplayActive(false)
+        producers.wait(); pump()
+        precondition(store.pendingForTest == 0 && !store.hasFlushTimerForTest)
+        MadeiraConfig.idleEnabled = false
+        store.setDisplayActive(false); pump()
+        precondition(store.hasFlushTimerForTest, "explicit UI-idle opt-out stopped working")
+        MadeiraConfig.idleEnabled = true
+        store.setDisplayActive(false); pump()
+
+        // Cover pausing before sources exist, repeated idempotent requests,
+        // dropping partial hidden lines, and cancelling suspended sources.
+        let tailFile = directory.appendingPathComponent("tail-test.log")
+        try Data().write(to: tailFile)
+        let lines = Lines()
+        let tail = LogTail(path: tailFile.path) { lines.append($0) }
+        tail.setDisplayPaused(true); tail.start(); tail.settleForTest()
+        try append("hidden-before-start\npartial-hidden", to: tailFile)
+        pump(0.3); tail.settleForTest()
+        precondition(lines.snapshot.isEmpty)
+        tail.setDisplayPaused(false); tail.settleForTest()
+        try append("visible-tail\n", to: tailFile)
+        pump(0.35); tail.settleForTest()
+        precondition(lines.snapshot == ["visible-tail"])
+        for _ in 0..<40 {
+            tail.setDisplayPaused(true); tail.setDisplayPaused(true)
+            tail.setDisplayPaused(false); tail.setDisplayPaused(false)
+        }
+        tail.settleForTest()
+        try append("still-live\n", to: tailFile)
+        pump(0.35); tail.settleForTest()
+        precondition(lines.snapshot == ["visible-tail", "still-live"])
+        tail.setDisplayPaused(true); tail.stop(); tail.settleForTest(); pump()
+        print("PASS: hidden UI/timers, persisted logs, callback race, pause/resume, partial lines and suspended-source stop")
+    }
+}
+'''
