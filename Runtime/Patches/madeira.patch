diff --git a/build/win32u-unix/vulkan_ios.c b/build/win32u-unix/vulkan_ios.c
new file mode 100644
index 0000000..d238d63
--- /dev/null
+++ b/build/win32u-unix/vulkan_ios.c
@@ -0,0 +1,388 @@
+/* Statically linked MoltenVK loader and Metal surface adapter for Wine. */
+#include "config_ios.h"
+#include <dlfcn.h>
+#include <string.h>
+#include <pthread.h>
+#include <time.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdatomic.h>
+#include "spirv_ios.h"
+#include "windef.h"
+#include "winbase.h"
+#include "wine/vulkan.h"
+
+extern PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance, const char *);
+extern PFN_vkVoidFunction vkGetDeviceProcAddr(VkDevice, const char *);
+extern VkResult vkDeviceWaitIdle(VkDevice);
+extern void vkDestroyDevice(VkDevice, const VkAllocationCallbacks *);
+extern VkResult vkQueueSubmit(VkQueue, uint32_t, const VkSubmitInfo *, VkFence);
+extern VkResult vkQueueSubmit2(VkQueue, uint32_t, const VkSubmitInfo2 *, VkFence);
+extern VkResult vkQueuePresentKHR(VkQueue, const VkPresentInfoKHR *);
+extern VkResult vkAcquireNextImageKHR(VkDevice, VkSwapchainKHR, uint64_t, VkSemaphore, VkFence, uint32_t *);
+extern VkResult vkAcquireNextImage2KHR(VkDevice, const VkAcquireNextImageInfoKHR *, uint32_t *);
+extern VkResult vkCreateShaderModule(VkDevice, const VkShaderModuleCreateInfo *, const VkAllocationCallbacks *, VkShaderModule *);
+extern VkResult vkCreateSwapchainKHR(VkDevice, const VkSwapchainCreateInfoKHR *, const VkAllocationCallbacks *, VkSwapchainKHR *);
+extern VkResult vkGetSwapchainImagesKHR(VkDevice, VkSwapchainKHR, uint32_t *, VkImage *);
+extern VkResult vkCreateImage(VkDevice, const VkImageCreateInfo *, const VkAllocationCallbacks *, VkImage *);
+extern VkResult vkWaitForFences(VkDevice, uint32_t, const VkFence *, VkBool32, uint64_t);
+extern VkResult vkWaitSemaphores(VkDevice, const VkSemaphoreWaitInfo *, uint64_t);
+extern VkResult vkQueueWaitIdle(VkQueue);
+
+static uint64_t ios_vk_now(void);
+
+/* Opt-in metadata only. Comparing startup with a render-scale round trip
+ * needs the actual target dimensions/sample count, not just settings.txt.
+ * Timings are cumulative elapsed time inside each Vulkan entry point across
+ * all threads, including waits, not CPU execution or GPU time. Counter loads
+ * are approximate snapshots; present calls are not displayed-frame counts.
+ * Never inspect image pixels,
+ * add synchronization, or change any arguments/results for diagnostics. */
+static pthread_once_t diag_once = PTHREAD_ONCE_INIT;
+static int diag_enabled;
+static _Atomic unsigned long long diag_present_count;
+enum diag_operation { DIAG_ACQUIRE, DIAG_SUBMIT, DIAG_PRESENT, DIAG_FENCE,
+                      DIAG_SEMAPHORE, DIAG_QUEUE_IDLE, DIAG_DEVICE_IDLE, DIAG_COUNT };
+static struct { _Atomic unsigned long long calls, ns; } diag_times[DIAG_COUNT];
+static void ios_vk_diag_init(void)
+{
+    const char *value = getenv("MADEIRA_VULKAN_DIAGNOSTICS");
+    diag_enabled = value && !strcmp(value, "1");
+}
+static uint64_t ios_vk_diag_start(void)
+{
+    pthread_once(&diag_once, ios_vk_diag_init);
+    return diag_enabled ? ios_vk_now() : 0;
+}
+static void ios_vk_diag_end(enum diag_operation operation, uint64_t start)
+{
+    if (!start) return;
+    atomic_fetch_add_explicit(&diag_times[operation].ns, ios_vk_now() - start, memory_order_relaxed);
+    atomic_fetch_add_explicit(&diag_times[operation].calls, 1, memory_order_relaxed);
+}
+static void ios_vk_diag_report(void)
+{
+    static const char *names[] = { "acquire", "submit", "present", "fence", "semaphore", "queueIdle", "deviceIdle" };
+    unsigned long long presents = atomic_fetch_add_explicit(&diag_present_count, 1, memory_order_relaxed) + 1;
+    if (presents % 120) return;
+    char line[1024];
+    int used = snprintf(line, sizeof(line), "[mewgenics-vk-timing] presents=%llu timeNs=%llu cumulativeCalls/elapsedMs", presents,
+                        (unsigned long long)ios_vk_now());
+    for (unsigned i = 0; i < DIAG_COUNT; ++i) {
+        unsigned long long calls = atomic_load_explicit(&diag_times[i].calls, memory_order_relaxed);
+        unsigned long long ns = atomic_load_explicit(&diag_times[i].ns, memory_order_relaxed);
+        used += snprintf(line + used, sizeof(line) - used, " %s=%llu/%.3fms", names[i], calls, ns / 1e6);
+    }
+    fprintf(stderr, "%s\n", line);
+}
+static VkResult ios_vk_image(VkDevice d, const VkImageCreateInfo *info,
+                             const VkAllocationCallbacks *allocator, VkImage *image)
+{
+    uint64_t start = ios_vk_diag_start();
+    VkResult result = vkCreateImage(d, info, allocator, image);
+    if (start && (info->usage & (VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT)))
+        fprintf(stderr, "[mewgenics-vk-target] presents=%llu timeNs=%llu device=%p image=%#llx extent=%ux%ux%u format=%u samples=%u usage=%#x flags=%#x mips=%u layers=%u result=%d\n",
+                atomic_load_explicit(&diag_present_count, memory_order_relaxed), (unsigned long long)start,
+                d, result == VK_SUCCESS ? (unsigned long long)(uintptr_t)*image : 0,
+                info->extent.width, info->extent.height, info->extent.depth, info->format,
+                info->samples, info->usage, info->flags, info->mipLevels, info->arrayLayers, result);
+    return result;
+}
+static VkResult ios_vk_wait_fences(VkDevice d, uint32_t count, const VkFence *fences, VkBool32 all, uint64_t timeout)
+{
+    uint64_t start = ios_vk_diag_start();
+    VkResult result = vkWaitForFences(d, count, fences, all, timeout);
+    ios_vk_diag_end(DIAG_FENCE, start);
+    return result;
+}
+static VkResult ios_vk_wait_semaphores(VkDevice d, const VkSemaphoreWaitInfo *info, uint64_t timeout)
+{
+    uint64_t start = ios_vk_diag_start();
+    VkResult result = vkWaitSemaphores(d, info, timeout);
+    ios_vk_diag_end(DIAG_SEMAPHORE, start);
+    return result;
+}
+static VkResult ios_vk_queue_idle(VkQueue queue)
+{
+    uint64_t start = ios_vk_diag_start();
+    VkResult result = vkQueueWaitIdle(queue);
+    ios_vk_diag_end(DIAG_QUEUE_IDLE, start);
+    return result;
+}
+static VkResult ios_vk_device_idle(VkDevice device)
+{
+    uint64_t start = ios_vk_diag_start();
+    VkResult result = vkDeviceWaitIdle(device);
+    ios_vk_diag_end(DIAG_DEVICE_IDLE, start);
+    return result;
+}
+
+static VkResult ios_vk_swapchain(VkDevice d, const VkSwapchainCreateInfoKHR *info,
+                                 const VkAllocationCallbacks *allocator, VkSwapchainKHR *swapchain)
+{
+    VkSwapchainCreateInfoKHR paced = *info;
+    /* Pinned MoltenVK 1.4.2 advertises a 2..3 image range and sets the
+     * CAMetalLayer drawable pool to this count. Zink requests the minimum.
+     * With two images, one can be on screen while the other is pending
+     * display, blocking the next frame's render pass in nextDrawable.
+     * Keep every GPU fence/semaphore, but allow a third image for rendering.
+     * Leave other counts (including shared-present single-image mode) alone.
+     * The opt-out supports a controlled A/B without another native build. */
+    const char *images = getenv("MADEIRA_VULKAN_SWAPCHAIN_IMAGES");
+    int ordinary = paced.presentMode == VK_PRESENT_MODE_IMMEDIATE_KHR ||
+                   paced.presentMode == VK_PRESENT_MODE_MAILBOX_KHR ||
+                   paced.presentMode == VK_PRESENT_MODE_FIFO_KHR ||
+                   paced.presentMode == VK_PRESENT_MODE_FIFO_RELAXED_KHR;
+    if (ordinary && paced.minImageCount == 2 && (!images || strcmp(images, "2")))
+        paced.minImageCount = 3;
+    VkResult result = vkCreateSwapchainKHR(d, &paced, allocator, swapchain);
+    uint32_t actual = 0;
+    if (result == VK_SUCCESS)
+        vkGetSwapchainImagesKHR(d, *swapchain, &actual, NULL);
+    fprintf(stderr, "[mewgenics-swapchain] requested=%u chosen=%u actual=%u mode=%u extent=%ux%u result=%d\n",
+            info->minImageCount, paced.minImageCount, actual, paced.presentMode,
+            paced.imageExtent.width, paced.imageExtent.height, result);
+    return result;
+}
+
+static VkResult ios_vk_shader_module(VkDevice d, const VkShaderModuleCreateInfo *info,
+                                    const VkAllocationCallbacks *allocator, VkShaderModule *module)
+{
+    if (info->codeSize % sizeof(uint32_t)) return vkCreateShaderModule(d, info, allocator, module);
+    uint32_t *code = malloc(info->codeSize);
+    if (!code) return VK_ERROR_OUT_OF_HOST_MEMORY;
+    memcpy(code, info->pCode, info->codeSize);
+    size_t count = madeira_spirv_sanitize_names(code, info->codeSize / sizeof(uint32_t));
+    VkShaderModuleCreateInfo fixed = *info;
+    if (count && count * sizeof(uint32_t) != info->codeSize) {
+        fixed.pCode = code;
+        fixed.codeSize = count * sizeof(uint32_t);
+        fprintf(stderr, "[mewgenics-vulkan] removed reserved sampler debug name from SPIR-V\n");
+    }
+    VkResult result = vkCreateShaderModule(d, &fixed, allocator, module);
+    free(code);
+    return result;
+}
+
+/* iPadOS rejects GPU command buffers submitted after backgrounding. Drain
+ * work while resigning active, then park producers until the app resumes. */
+static pthread_mutex_t gpu_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t gpu_active_cond = PTHREAD_COND_INITIALIZER;
+static int gpu_active = 1;
+static unsigned gpu_inflight;
+static VkDevice gpu_devices[16];
+void madeira_vulkan_set_active(int active)
+{
+    pthread_mutex_lock(&gpu_lock);
+    gpu_active = active;
+    if (active) pthread_cond_broadcast(&gpu_active_cond);
+    else {
+        while (gpu_inflight) pthread_cond_wait(&gpu_active_cond, &gpu_lock);
+        for (unsigned i = 0; i < 16; ++i)
+            if (gpu_devices[i]) vkDeviceWaitIdle(gpu_devices[i]);
+    }
+    fprintf(stderr, "[mewgenics-vulkan] active=%d inflight=%u\n", active, gpu_inflight);
+    pthread_mutex_unlock(&gpu_lock);
+}
+static void ios_vk_begin_work(void)
+{
+    pthread_mutex_lock(&gpu_lock);
+    while (!gpu_active) pthread_cond_wait(&gpu_active_cond, &gpu_lock);
+    ++gpu_inflight;
+    pthread_mutex_unlock(&gpu_lock);
+}
+static void ios_vk_end_work(void)
+{
+    pthread_mutex_lock(&gpu_lock);
+    if (!--gpu_inflight) pthread_cond_broadcast(&gpu_active_cond);
+    pthread_mutex_unlock(&gpu_lock);
+}
+static VkResult ios_vk_submit(VkQueue q, uint32_t n, const VkSubmitInfo *s, VkFence f)
+{
+    ios_vk_begin_work(); uint64_t start = ios_vk_diag_start();
+    VkResult r = vkQueueSubmit(q, n, s, f);
+    ios_vk_diag_end(DIAG_SUBMIT, start);
+    ios_vk_end_work(); return r;
+}
+static VkResult ios_vk_submit2(VkQueue q, uint32_t n, const VkSubmitInfo2 *s, VkFence f)
+{
+    ios_vk_begin_work(); uint64_t start = ios_vk_diag_start();
+    VkResult r = vkQueueSubmit2(q, n, s, f);
+    ios_vk_diag_end(DIAG_SUBMIT, start);
+    ios_vk_end_work(); return r;
+}
+static VkResult ios_vk_present(VkQueue q, const VkPresentInfoKHR *p)
+{
+    ios_vk_begin_work(); uint64_t start = ios_vk_diag_start();
+    VkResult r = vkQueuePresentKHR(q, p);
+    ios_vk_diag_end(DIAG_PRESENT, start);
+    ios_vk_end_work();
+    if (start) ios_vk_diag_report();
+    if (r != VK_SUCCESS) fprintf(stderr, "[mewgenics-vulkan] present result=%d\n", r);
+    return r;
+}
+static uint64_t ios_vk_now(void)
+{
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    return (uint64_t)now.tv_sec * 1000000000ull + now.tv_nsec;
+}
+/* Acquiring an image may wait for another thread to submit/present. Never
+ * hold the submission mutex across that wait. Bounded waits also let the
+ * lifecycle drain finish when the app loses focus with no image available. */
+static VkResult ios_vk_acquire(VkDevice d, VkSwapchainKHR s, uint64_t t, VkSemaphore sem, VkFence f, uint32_t *i)
+{
+    uint64_t start = ios_vk_now(), remaining = t;
+    for (;;) {
+        ios_vk_begin_work();
+        uint64_t diag_start = ios_vk_diag_start();
+        VkResult r = vkAcquireNextImageKHR(d, s, remaining < 100000000ull ? remaining : 100000000ull, sem, f, i);
+        ios_vk_diag_end(DIAG_ACQUIRE, diag_start);
+        ios_vk_end_work();
+        if (r != VK_TIMEOUT || !t) return r;
+        if (t != UINT64_MAX) {
+            uint64_t elapsed = ios_vk_now() - start;
+            if (elapsed >= t) return VK_TIMEOUT;
+            remaining = t - elapsed;
+        }
+    }
+}
+static VkResult ios_vk_acquire2(VkDevice d, const VkAcquireNextImageInfoKHR *p, uint32_t *i)
+{
+    VkAcquireNextImageInfoKHR bounded = *p;
+    uint64_t start = ios_vk_now(), remaining = p->timeout;
+    for (;;) {
+        bounded.timeout = remaining < 100000000ull ? remaining : 100000000ull;
+        ios_vk_begin_work();
+        uint64_t diag_start = ios_vk_diag_start();
+        VkResult r = vkAcquireNextImage2KHR(d, &bounded, i);
+        ios_vk_diag_end(DIAG_ACQUIRE, diag_start);
+        ios_vk_end_work();
+        if (r != VK_TIMEOUT || !p->timeout) return r;
+        if (p->timeout != UINT64_MAX) {
+            uint64_t elapsed = ios_vk_now() - start;
+            if (elapsed >= p->timeout) return VK_TIMEOUT;
+            remaining = p->timeout - elapsed;
+        }
+    }
+}
+static void ios_vk_destroy_device(VkDevice d, const VkAllocationCallbacks *a)
+{
+    pthread_mutex_lock(&gpu_lock);
+    for (unsigned i = 0; i < 16; ++i) if (gpu_devices[i] == d) gpu_devices[i] = NULL;
+    vkDestroyDevice(d, a);
+    pthread_mutex_unlock(&gpu_lock);
+}
+static PFN_vkVoidFunction ios_vk_device_proc(VkDevice d, const char *name)
+{
+    pthread_mutex_lock(&gpu_lock);
+    unsigned i;
+    for (i = 0; i < 16; ++i) if (gpu_devices[i] == d) break;
+    if (i == 16) for (i = 0; i < 16; ++i) if (!gpu_devices[i]) { gpu_devices[i] = d; break; }
+    pthread_mutex_unlock(&gpu_lock);
+    PFN_vkVoidFunction p = vkGetDeviceProcAddr(d, name);
+    if (!p) return NULL;
+    if (!strcmp(name, "vkCreateSwapchainKHR")) return (PFN_vkVoidFunction)ios_vk_swapchain;
+    if (!strcmp(name, "vkCreateShaderModule")) return (PFN_vkVoidFunction)ios_vk_shader_module;
+    if (!strcmp(name, "vkCreateImage")) return (PFN_vkVoidFunction)ios_vk_image;
+    if (!strcmp(name, "vkWaitForFences")) return (PFN_vkVoidFunction)ios_vk_wait_fences;
+    if (!strcmp(name, "vkWaitSemaphores") || !strcmp(name, "vkWaitSemaphoresKHR")) return (PFN_vkVoidFunction)ios_vk_wait_semaphores;
+    if (!strcmp(name, "vkQueueWaitIdle")) return (PFN_vkVoidFunction)ios_vk_queue_idle;
+    if (!strcmp(name, "vkDeviceWaitIdle")) return (PFN_vkVoidFunction)ios_vk_device_idle;
+    if (!strcmp(name, "vkDestroyDevice")) return (PFN_vkVoidFunction)ios_vk_destroy_device;
+    if (!strcmp(name, "vkQueueSubmit")) return (PFN_vkVoidFunction)ios_vk_submit;
+    if (!strcmp(name, "vkQueueSubmit2") || !strcmp(name, "vkQueueSubmit2KHR")) return (PFN_vkVoidFunction)ios_vk_submit2;
+    if (!strcmp(name, "vkQueuePresentKHR")) return (PFN_vkVoidFunction)ios_vk_present;
+    if (!strcmp(name, "vkAcquireNextImageKHR")) return (PFN_vkVoidFunction)ios_vk_acquire;
+    if (!strcmp(name, "vkAcquireNextImage2KHR")) return (PFN_vkVoidFunction)ios_vk_acquire2;
+    return p;
+}
+static PFN_vkVoidFunction ios_vk_instance_proc(VkInstance instance, const char *name)
+{
+    if (!strcmp(name, "vkGetDeviceProcAddr")) return (PFN_vkVoidFunction)ios_vk_device_proc;
+    return vkGetInstanceProcAddr(instance, name);
+}
+
+static void *ios_vk_open(const char *name, int flags)
+{
+    if (!strcmp(name, "madeira-static-moltenvk")) return RTLD_DEFAULT;
+    return dlopen(name, flags);
+}
+static void *ios_vk_symbol(void *handle, const char *name)
+{
+    if (handle == RTLD_DEFAULT) {
+        if (!strcmp(name, "vkGetInstanceProcAddr")) return (void *)ios_vk_instance_proc;
+        if (!strcmp(name, "vkGetDeviceProcAddr")) return (void *)ios_vk_device_proc;
+    }
+    return dlsym(handle, name);
+}
+static int ios_vk_close(void *handle)
+{
+    return handle == RTLD_DEFAULT ? 0 : dlclose(handle);
+}
+#define SONAME_LIBVULKAN "madeira-static-moltenvk"
+#define dlopen ios_vk_open
+#define dlsym ios_vk_symbol
+#define dlclose ios_vk_close
+#include "../../wine/dlls/win32u/vulkan.c"
+#undef dlopen
+#undef dlsym
+#undef dlclose
+
+extern void *winios_vulkan_layer_for_hwnd(void *hwnd);
+extern void winios_gpu_present(void *hwnd);
+
+static void ios_vk_client_destroy(struct client_surface *client) { }
+static void ios_vk_client_detach(struct client_surface *client) { }
+static void ios_vk_client_update(struct client_surface *client) { }
+static void ios_vk_client_present(struct client_surface *client, HDC hdc)
+{
+    winios_gpu_present(client->hwnd);
+}
+static const struct client_surface_funcs ios_vk_client_funcs = {
+    ios_vk_client_destroy, ios_vk_client_detach, ios_vk_client_update, ios_vk_client_present
+};
+
+static VkResult ios_vk_surface_create(HWND hwnd, const struct vulkan_instance *instance,
+                                     VkSurfaceKHR *surface, struct client_surface **client)
+{
+    void *layer = winios_vulkan_layer_for_hwnd(hwnd);
+    if (!layer || !instance->p_vkCreateMetalSurfaceEXT) return VK_ERROR_INCOMPATIBLE_DRIVER;
+    *client = client_surface_create(sizeof(**client), &ios_vk_client_funcs, hwnd);
+    if (!*client) return VK_ERROR_OUT_OF_HOST_MEMORY;
+    VkMetalSurfaceCreateInfoEXT info = {
+        .sType = VK_STRUCTURE_TYPE_METAL_SURFACE_CREATE_INFO_EXT,
+        .pLayer = layer,
+    };
+    VkResult result = instance->p_vkCreateMetalSurfaceEXT(instance->host.instance, &info, NULL, surface);
+    if (result != VK_SUCCESS) { client_surface_release(*client); *client = NULL; }
+    fprintf(stderr, "[mewgenics-vulkan] Metal surface hwnd=%p result=%d\n", hwnd, result);
+    return result;
+}
+static VkBool32 ios_vk_presentation_support(struct vulkan_physical_device *device, uint32_t queue)
+{
+    return VK_TRUE;
+}
+static void ios_vk_instance_extensions(struct vulkan_instance_extensions *ext)
+{
+    if (ext->has_VK_KHR_win32_surface) ext->has_VK_EXT_metal_surface = 1;
+    if (ext->has_VK_EXT_metal_surface) ext->has_VK_KHR_win32_surface = 1;
+}
+static void ios_vk_device_extensions(struct vulkan_device_extensions *ext)
+{
+    /* The Windows Zink build lacks its compile-time MoltenVK guard for
+     * host copies of depth/stencil images. Use its staging-buffer path. */
+    ext->has_VK_EXT_host_image_copy = 0;
+}
+static const struct vulkan_driver_funcs ios_vk_driver = {
+    .p_vulkan_surface_create = ios_vk_surface_create,
+    .p_get_physical_device_presentation_support = ios_vk_presentation_support,
+    .p_map_instance_extensions = ios_vk_instance_extensions,
+    .p_map_device_extensions = ios_vk_device_extensions,
+};
+UINT winios_VulkanInit(UINT version, void *handle, const struct vulkan_driver_funcs **funcs)
+{
+    if (version != WINE_VULKAN_DRIVER_VERSION) return STATUS_INVALID_PARAMETER;
+    *funcs = &ios_vk_driver;
+    return STATUS_SUCCESS;
+}
