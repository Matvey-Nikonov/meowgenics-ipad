+    subprocess.run(["xcrun", "swiftc", "-O", "-parse-as-library", "-swift-version", "5",
+                    str(source), "-o", str(path / "check")], check=True)
+    subprocess.run([str(path / "check"), str(path)], check=True, timeout=30)
