+view = reset(); a = UITouch(20, 30); b = UITouch(100, 30)
+view.began(a, b); a.point.y += 28; b.point.y += 28; view.moved(a, b)
+a.point.x -= 28; b.point.x += 28; view.moved(a, b)
+view.ended(a, b); expect(["wheel:120", "wheel:120"], "scroll cannot double as pinch")
+view = reset(); a = UITouch(20, 30); b = UITouch(100, 30)
+view.began(a, b); a.point.y += 0.1; b.point.y += 0.1; view.moved(a, b)
