+    static func toggleKeyboard() { keyboardToggles += 1 }
+    func pencilHovered(at point: CGPoint) {}
+    private func mapPoint(_ p: CGPoint) -> (Int32, Int32) { (Int32(p.x), Int32(p.y)) }
+    private func avgPoint(_ touches: [UITouch]) -> CGPoint {
+        let n = CGFloat(touches.count)
