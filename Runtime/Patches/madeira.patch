+pencil = '    private var gamePointerPosition:' + pencil
+touch = source.split('    private var tmDownPoints:', 1)[1].split('    // ==================================================================\n    // S2 desktop mode', 1)[0]
+touch = '    private var tmDownPoints:' + touch
+
+stubs = r'''
+import Foundation
+import CoreGraphics
+var events: [String] = []
+var keyboardToggles = 0
+func winios_post_touch_down(_ x: Int32, _ y: Int32) { events.append("L+") }
+func winios_post_touch_move(_ x: Int32, _ y: Int32) { events.append("move") }
+func winios_post_touch_up(_ x: Int32, _ y: Int32) { events.append("L-") }
+func winios_cursor_move(_ x: Int32, _ y: Int32) {}
+func winios_pointer(_ x: Int32, _ y: Int32, _ flags: UInt32, _ data: UInt32) {
+    if flags & 0x800 != 0 { events.append("wheel:\(Int32(bitPattern: data))") }
+}
+struct winios_direct_cursor_state { var x: Int32 = 55; var y: Int32 = 66 }
+func winios_direct_cursor_get(_ cursor: inout winios_direct_cursor_state) {}
+struct Deadline {
+    static func now() -> Deadline { Deadline() }
+    static func + (_ lhs: Deadline, _ rhs: Double) -> Deadline { lhs }
+}
+final class DispatchQueue {
+    static let main = DispatchQueue()
+    var pending: [() -> Void] = []
+    func asyncAfter(deadline: Deadline, execute: @escaping () -> Void) { pending.append(execute) }
+    func advance() { let work = pending; pending = []; work.forEach { $0() } }
+}
+final class UITouch: NSObject {
+    enum TouchType { case direct, pencil }
+    let type: TouchType
+    var point: CGPoint
+    init(_ x: Double, _ y: Double, _ type: TouchType = .direct) { point = CGPoint(x: x, y: y); self.type = type }
+    func location(in view: MetalBackedView) -> CGPoint { point }
+}
+final class UIEvent {}
+enum UIPencilInteraction {
+    enum Phase { case began, changed, ended, cancelled }
+    struct Pose { let location: CGPoint }
+    struct Squeeze { let phase: Phase; var hoverPose: Pose? = nil }
+}
+final class InputSettings {
+    static let shared = InputSettings()
+    var touchMode = true
