+        if pressed && !allowed { return }
+        if pressed != rightHeld { events.append(pressed ? "R+" : "R-") }
+        rightHeld = pressed
+    }
+    func toggleTacticalView() { tactical.toggle(); events.append("Ctrl") }
+    func pulseGameEscape() { events.append("Esc") }
