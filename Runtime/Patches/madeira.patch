diff --git a/build/win32u-unix/spirv_ios.h b/build/win32u-unix/spirv_ios.h
new file mode 100644
index 0000000..c3a5c80
--- /dev/null
+++ b/build/win32u-unix/spirv_ios.h
@@ -0,0 +1,34 @@
+#ifndef MADEIRA_SPIRV_IOS_H
+#define MADEIRA_SPIRV_IOS_H
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+/* SPIR-V OpName (5) and OpMemberName (6) are optional debug instructions.
+ * SPIRV-Cross in MoltenVK 1.4.2 can emit a texture named "sampler" before a
+ * Metal sampler declaration, hiding the Metal type and failing compilation.
+ * Remove only that name; IDs, bindings, entry points and executable code stay
+ * unchanged. Return 0 for malformed input, without modifying it. */
+static size_t madeira_spirv_sanitize_names(uint32_t *words, size_t count)
+{
+    if (count < 5 || words[0] != 0x07230203) return 0;
+    for (size_t i = 5; i < count;) {
+        size_t n = words[i] >> 16;
+        if (!n || n > count - i) return 0;
+        i += n;
+    }
+    size_t out = 5;
+    for (size_t i = 5; i < count;) {
+        size_t n = words[i] >> 16;
+        unsigned op = words[i] & 0xffff;
+        size_t name = op == 5 ? 2 : op == 6 ? 3 : n;
+        int reserved = n >= name + 2 && !memcmp(words + i + name, "sampler", 8);
+        if (!reserved) {
+            memmove(words + out, words + i, n * sizeof(*words));
+            out += n;
+        }
+        i += n;
+    }
+    return out;
+}
+#endif
