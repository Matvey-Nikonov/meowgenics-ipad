@@ -0,0 +1,87 @@
+#!/usr/bin/env python3
+"""Exercise the production process-wide launch state with recreated view owners.
+
+No device, Wine runtime, JIT allocation or UIKit lifecycle is simulated here.
+The signed iPad build checks UIKit integration; background survival still
+requires an on-device test. Set TMPDIR and CLANG_MODULE_CACHE_PATH externally.
+"""
+from pathlib import Path
+import os
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[2]
+source = (root / "app/Madeira/ContentView.swift").read_text()
+state = source.split("@MainActor\nfinal class MewgenicsSessionState", 1)[1].split("\nstruct ContentView:", 1)[0]
+state = "@MainActor\nfinal class MewgenicsSessionState" + state
+
+harness = r'''
+import Foundation
+import Combine
+PRODUCTION_STATE
+
+@MainActor
+struct ViewOwner {
+    let session: MewgenicsSessionState
+    func appear() -> Bool { session.beginBootstrap() }
+    func requestJIT() -> Bool { session.beginPreparation() }
+    func JITReady() -> Bool { session.beginLaunch() }
+}
+
+@main struct Checks {
+    @MainActor static func main() {
+        let session = MewgenicsSessionState()
+        let initial = ViewOwner(session: session)
+        precondition(initial.appear())
+        // View recreation before requesting JIT does not repeat bootstrap.
+        precondition(!ViewOwner(session: session).appear())
+        precondition(initial.requestJIT())
+        precondition(session.preparing && !session.launchStarted)
+        // An interrupted StikDebug handoff retains the same pending request.
+        for _ in 0..<100 {
+            let replacement = ViewOwner(session: session)
+            precondition(!replacement.appear())
+            precondition(!replacement.requestJIT())
+        }
+        // The original callback remains valid after its view owner disappears.
+        precondition(initial.JITReady())
+        precondition(session.launchStarted && !session.preparing)
+        for _ in 0..<100 {
+            let replacement = ViewOwner(session: session)
+            precondition(!replacement.appear())
+            precondition(!replacement.requestJIT())
+            precondition(!replacement.JITReady())
+        }
+        session.failPreparation("late failure")
+        precondition(session.launchStarted && session.error == nil)
+
+        // A real preparation failure can be retried once, with its error
+        // visible to replacement views and cleared only by the new request.
+        let retry = MewgenicsSessionState()
+        precondition(retry.beginBootstrap() && retry.beginPreparation())
+        retry.failPreparation("JIT unavailable")
+        let replacement = ViewOwner(session: retry)
+        precondition(!replacement.appear())
+        precondition(replacement.session.error == "JIT unavailable")
+        precondition(!retry.preparing && !retry.launchStarted)
+        precondition(replacement.requestJIT() && retry.error == nil)
+        precondition(!replacement.requestJIT())
+        precondition(replacement.JITReady() && !replacement.JITReady())
+
+        // Persisted lifecycle breadcrumbs must not prevent a cold process
+        // from bootstrapping. There is no UserDefaults launch-state storage.
+        let cold = MewgenicsSessionState()
+        precondition(!cold.bootstrapped && !cold.preparing && !cold.launchStarted)
+        precondition(cold.beginBootstrap() && cold.beginPreparation() && cold.beginLaunch())
+        precondition(MewgenicsSessionState.shared === MewgenicsSessionState.shared)
+        print("PASS: view recreation, pending JIT, one launch, retry, late callback and cold launch")
+    }
+}
+'''.replace("PRODUCTION_STATE", state)
+
+with tempfile.TemporaryDirectory(prefix="mewgenics-session-", dir=os.environ["TMPDIR"]) as temporary:
+    path = Path(temporary)
+    (path / "check.swift").write_text(harness)
+    subprocess.run(["xcrun", "swiftc", "-parse-as-library", "-swift-version", "5",
+                    str(path / "check.swift"), "-o", str(path / "check")], check=True)
+    subprocess.run([str(path / "check")], check=True)
