index 0b62427..9477ec0 100644
--- a/app/Madeira/MadeiraApp.swift
+++ b/app/Madeira/MadeiraApp.swift
@@ -1,7 +1,73 @@
 import SwiftUI
+import Darwin
+
+/// Keep only a diagnostic breadcrumb across process death. Launch/JIT state
+/// is deliberately process-local: a cold launch must allocate a fresh runtime.
+@MainActor
+enum MewgenicsLifecycle {
+    private static let session = UUID().uuidString
+    private static let previousKey = "mewgenics.lifecycle.lastEvent"
+    private static var observers: [NSObjectProtocol] = []
+
+    static func start() {
+        guard observers.isEmpty else { return }
+        if let previous = UserDefaults.standard.string(forKey: previousKey) {
+            LogStore.shared.log("[mewgenics-lifecycle] previous-process \(previous); last recorded state, not a termination diagnosis")
+        }
+        let events: [(Notification.Name, String)] = [
+            (UIApplication.willResignActiveNotification, "inactive"),
+            (UIApplication.didEnterBackgroundNotification, "background"),
+            (UIApplication.willEnterForegroundNotification, "foreground"),
+            (UIApplication.didBecomeActiveNotification, "active"),
+            (UIApplication.didReceiveMemoryWarningNotification, "memory-warning"),
+            (UIApplication.willTerminateNotification, "will-terminate")
+        ]
+        observers = events.map { name, event in
+            NotificationCenter.default.addObserver(forName: name, object: nil, queue: .main) { _ in
+                // OperationQueue.main guarantees synchronous main-thread
+                // delivery; preserve the event's state before suspension.
+                MainActor.assumeIsolated { record(event) }
+            }
+        }
+        record("cold-launch")
+    }
+
+    static func record(_ event: String) {
+        var info = task_vm_info_data_t()
+        var count = mach_msg_type_number_t(MemoryLayout<task_vm_info_data_t>.size / MemoryLayout<natural_t>.size)
+        let result = withUnsafeMutablePointer(to: &info) {
+            $0.withMemoryRebound(to: integer_t.self, capacity: Int(count)) {
+                task_info(mach_task_self_, task_flavor_t(TASK_VM_INFO), $0, &count)
+            }
+        }
+        let footprint = result == KERN_SUCCESS ? Int(info.phys_footprint / 1048576) : -1
+        let game = MewgenicsSessionState.shared
+        let line = "session=\(session) pid=\(getpid()) event=\(event) " +
+            "time=\(Date().timeIntervalSince1970) appState=\(UIApplication.shared.applicationState.rawValue) " +
+            "preparing=\(game.preparing) launchStarted=\(game.launchStarted) " +
+            "wine=\(wine_process_is_running()) debugged=\(jit_check_debugged()) " +
+            "debuggerAttached=\(jit_debugger_attached()) footprintMiB=\(footprint)"
+        LogStore.shared.log("[mewgenics-lifecycle] \(line)")
+        UserDefaults.standard.set(line, forKey: previousKey)
+    }
+}
+
+final class MewgenicsAppDelegate: NSObject, UIApplicationDelegate {
+    func application(_ application: UIApplication,
+                     didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]? = nil) -> Bool {
+        MewgenicsLifecycle.start()
+        return true
+    }
+
+    func application(_ application: UIApplication,
+                     supportedInterfaceOrientationsFor window: UIWindow?) -> UIInterfaceOrientationMask {
+        .landscape
+    }
+}
 
 @main
 struct MadeiraApp: App {
+    @UIApplicationDelegateAdaptor(MewgenicsAppDelegate.self) private var appDelegate
     var body: some Scene {
         WindowGroup {
             ContentView()
