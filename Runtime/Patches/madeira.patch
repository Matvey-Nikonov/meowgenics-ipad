+# A clean checkout has no base archive. Compile all unmodified server sources
+# from the pinned Wine tree; the platform replacements below supply the rest.
+if [ ! -f "$OBJ_DIR/libwineserver.a" ]; then
+    echo "=== Building base wineserver from source ==="
+    BASE_OBJECTS=()
+    for src in "$WINE_SRC/server/"*.c; do
+        old_obj="$(basename "${src%.c}").o"
+        replaced=0
+        for entry in "${PATCHED_FILES[@]}"; do
+            if [ "${entry##*:}" = "$old_obj" ]; then replaced=1; break; fi
+        done
+        [ "$replaced" = 1 ] && continue
+        compile_one "$src" "${old_obj%.o}"
+        BASE_OBJECTS+=("$OBJ_DIR/$old_obj")
+    done
+    ar rcs "$OBJ_DIR/libwineserver.a" "${BASE_OBJECTS[@]}"
+fi
