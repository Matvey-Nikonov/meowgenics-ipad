#!/bin/sh
# Audit each local ref that Git is about to publish, including complete history.
# No network action or history modification is performed by this hook.
set -u
root=$(git rev-parse --show-toplevel) || exit 1
audit="$root/Scripts/audit-publication.py"
if [ ! -f "$audit" ]; then
    echo 'Publication blocked: Scripts/audit-publication.py is missing.' >&2
    exit 1
fi
status=0
while read -r local_ref local_sha remote_ref remote_sha extra; do
    if [ -z "$local_ref" ] || [ -z "$local_sha" ] || [ -z "$remote_ref" ] ||
       [ -z "$remote_sha" ] || [ -n "$extra" ]; then
        echo 'Publication blocked: invalid pre-push ref input.' >&2
        exit 1
    fi
    case "$local_sha" in
        *[!0]*) ;;
        *) continue ;; # A deleted ref does not introduce repository content.
    esac
    printf 'Checking publication ref %s -> %s\n' "$local_ref" "$remote_ref"
    python3 "$audit" "$local_sha" || status=1
done
exit "$status"
